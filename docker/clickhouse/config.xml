<!-- docker/clickhouse/config.xml -->
<!-- Minimal ClickHouse config override for local development. -->
<!-- Full config reference: https://clickhouse.com/docs/en/operations/configuration-files -->

<clickhouse>
    <!-- Logging: keep logs concise in development -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>
</clickhouse>
